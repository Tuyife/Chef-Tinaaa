PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/chef_tinaaa

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Payment providers (optional — leave blank until keys are provisioned).
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Offline payment details — shown to clients after booking
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_INSTRUCTIONS=

# Secure admin seeding (used by `npm run seed` in server/).
ADMIN_EMAIL=admin@cheftinaaa.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Chef Tinaaa
