# Copy to .env.local (development) or set in Vercel (production).
# Where the Express API lives. Leave empty in dev to use the vite proxy
# (http://localhost:5000). In production point it at the hosted backend.
VITE_API_URL=https://your-backend.example.com

# Offline payment details — configured in server/.env
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_INSTRUCTIONS=
